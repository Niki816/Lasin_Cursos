# ============================================
# SERVIDOR
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# BASE DE DATOS
# Local: postgresql://USER:PASSWORD@localhost:5432/DB_NAME
# Neon:  postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require
# ============================================
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/sistema_cursos_dev?schema=public"

# ============================================
# JWT (generar con: openssl rand -base64 32)
# ============================================
JWT_SECRET=tu_secreto_de_minimo_32_caracteres_aqui
JWT_EXPIRES_IN=7d

# ============================================
# CLOUDINARY
# https://console.cloudinary.com/settings/api-keys
# ============================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ============================================
# SMTP (Email)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM="LASIN <no-reply@lasin.com>"

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:3001

# ============================================
# SEED (admin inicial)
# ============================================
ADMIN_EMAIL=admin@lasin.com
ADMIN_PASSWORD=Admin123!